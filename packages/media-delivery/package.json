{
  "name": "@nakh/media-delivery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./edge": {
      "types": "./src/edge.ts",
      "default": "./dist/edge.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/edge.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
