{
  "name": "@nakh/persistence-postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli/migrate.ts src/cli/verify.ts src/cli/status.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nakh/application": "workspace:*",
    "@nakh/contracts": "workspace:*",
    "@nakh/config": "workspace:*",
    "@nakh/domain": "workspace:*",
    "kysely": "catalog:",
    "pg": "catalog:"
  }
}
