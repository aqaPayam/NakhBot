{
  "name": "nakh-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "clean": "pnpm -r --workspace-concurrency=1 --if-present clean",
    "dev:api": "pnpm --filter @nakh/api dev",
    "dev:telegram": "pnpm --filter @nakh/telegram-gateway dev",
    "dev:worker": "pnpm --filter @nakh/worker dev",
    "dev:scheduler": "pnpm --filter @nakh/scheduler dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.ts",
    "test:integration:ci": "tsx scripts/postgres-integration-ci.ts",
    "test:m1-load-smoke": "tsx scripts/m1-load-smoke.ts",
    "test:m3-load-smoke": "tsx scripts/m3-load-smoke.ts",
    "test:m3-query-plan": "tsx scripts/m3-query-plan-gate.ts",
    "test:m4-query-plan": "tsx scripts/m4-query-plan-gate.ts",
    "test:m5-load-smoke": "tsx scripts/m5-load-smoke.ts",
    "test:m5-query-plan": "tsx scripts/m5-query-plan-gate.ts",
    "test:m6-query-plan": "tsx scripts/m6-query-plan-gate.ts",
    "test:m6-load-smoke": "tsx scripts/m6-load-smoke.ts",
    "test:m7-query-plan": "tsx scripts/m7-query-plan-gate.ts",
    "test:m7-load-smoke": "tsx scripts/m7-load-smoke.ts",
    "test:m8-collector": "tsx packages/observability/src/m8-collector-rehearsal.ts",
    "test:m7-collector": "tsx packages/observability/src/m7-collector-rehearsal.ts",
    "audit:security": "tsx scripts/audit-production.ts",
    "db:migrate": "tsx packages/persistence-postgres/src/cli/migrate.ts",
    "db:verify": "tsx packages/persistence-postgres/src/cli/verify.ts",
    "release:reference": "tsx packages/persistence-postgres/src/cli/release-reference.ts",
    "db:status": "tsx packages/persistence-postgres/src/cli/status.ts",
    "admin:operator": "tsx packages/persistence-postgres/src/cli/admin-totp-operator.ts",
    "launch:operator": "tsx packages/persistence-postgres/src/cli/launch-operator.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:provision-roles": "tsx packages/persistence-postgres/src/cli/provision-runtime-roles.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-boundaries": "7.4.1",
    "prettier": "3.9.10",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
