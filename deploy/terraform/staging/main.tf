module "runtime" {
  source                              = "../modules/runtime"
  project_name                        = var.project_name
  environment                         = var.environment
  aws_region                          = var.aws_region
  vpc_cidr                            = var.vpc_cidr
  public_hostname                     = var.public_hostname
  route53_zone_id                     = var.route53_zone_id
  image_tag                           = var.image_tag
  image_digests                       = var.image_digests
  activate_services                   = var.activate_services
  service_min_replicas                = var.service_min_replicas
  release_scaling_hold                = var.release_scaling_hold
  release_capacity                    = var.release_capacity
  service_max_replicas                = var.service_max_replicas
  postgres_engine_version             = var.postgres_engine_version
  database_instance_class             = var.database_instance_class
  redis_engine_version                = var.redis_engine_version
  redis_node_type                     = var.redis_node_type
  telegram_webhook_secret             = var.telegram_webhook_secret
  telegram_bot_token                  = var.telegram_bot_token
  telegram_action_token_key           = var.telegram_action_token_key
  monthly_budget_usd                  = var.monthly_budget_usd
  alert_email                         = var.alert_email
  deletion_protection                 = var.deletion_protection
  skip_final_snapshot                 = var.skip_final_snapshot
  otel_collector_image                = var.otel_collector_image
  account_deletion_monitoring_enabled = var.account_deletion_monitoring_enabled
  account_deletion_due_age_seconds    = var.account_deletion_due_age_seconds
  account_deletion_oldest_age_seconds = var.account_deletion_oldest_age_seconds
  expected_aws_account_id             = var.expected_aws_account_id
  staging_aws_account_id              = var.staging_aws_account_id
  product_runtime                     = var.product_runtime
  database_role_isolation_enabled     = var.database_role_isolation_enabled
}
